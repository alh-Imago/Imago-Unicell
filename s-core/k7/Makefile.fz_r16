# Makefile.fz_r16 - GENERATED by make_fz_v3.py from Makefile.v2: clock test of uc_unitr16 (project sc_k7_fz_r16).
# Makefile.v2 - the stage 1 build with the fixed host link (jtag_link_v2, sc_top_k7_v3).  Use:  make -f Makefile.v2   (same folder rules as Makefile; the pin file is unchanged)
# sc_k7_v1: the S-Core pool (batch sequencer, copy engine, block-RAM far RAM, JTAG host link) on the Kintex-7 YPCB-00338-1P1 card.
# Build ONLY inside the nix shell:   nix develop github:openxc7/toolchain-nix
# Before the first build check that the chip database is loaded:   echo $KINTEX7_CHIPDB ; ls -l $KINTEX7_CHIPDB   (if it is missing the tool would regenerate it: stop)
# Copy this whole folder into demo-projects/ (next to blinky-ypcb003381p1) so ../openXC7.mk is found, then:
#   S_CORE=$HOME/Imago-Unicell-score/s-core sh stage.sh        (copies the RTL into rtl/ as .sv)
#   make                                                         (build)      make program JTAG_LINK="-c ft232"   (load into SRAM only)
# Never write the card's flash. Never load a bitstream whose timing check failed.
FAMILY  = kintex7
PART    = xc7k480tffg1156-1
BOARD   = ypcb003381p1
PROJECT = sc_k7_fz_r16
TOP_MODULE = top
XDC     = sc_k7_v1.xdc
ADDITIONAL_SOURCES = rtl/uc_unitr16.sv rtl/uc_unitp16.sv
CHIPDB  = ${KINTEX7_CHIPDB}
PYPY3  ?= python3

include ../openXC7.mk
