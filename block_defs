not:
	1, 0, 1
	z0 = nor x0, x0

or:
	2, 1, 1
	y0 = nor x0, x1
	z0 = not y0

and:
	2, 2, 1
	y0 = not x0
	y1 = not x1
	z0 = nor y0, y1

nand:
	2, 1, 1
	y0 = and x0, x1
	z0 = not y0

xor:
	2, 4, 1
	y0 = nor x0, x1
	y1 = not x0
	y2 = not x1
	y3 = nor y1, y2
	z0 = nor y0, y3

xnor:
	2, 1, 1
	y0 = xor x0, x1
	z0 = not y0

half_adder:
	2, 0, 2
	z0 = xor x0, x1
	z1 = and x0, x1

full_adder:
	3, 4, 2
	y0, y1 = half_adder x0, x1
	y2, y3 = half_adder y0, x2
	z0 = or y2, y2
	z1 = or y1, y3

mux:
	3, 4, 1
	y0 = not x2
	y1 = and x0, y0
	y2 = and x1, x2
	z0 = or y1, y2

