{
  "format_version": 2,
  "address_width": 32,
  "program_id": "wired3_v1",
  "name": "wired3",
  "description": "Arbitrary-wiring ICM: three cells whose in/out addresses are deliberately NOT the physical defaults (in=CELL_ID, out=CELL_ID+1). Proves the loader streams per-cell in/out via SET_INPUT/SET_OUTPUT on the held target (Option A: cell addr_match-gated, target on the address lane). cell0 and cell1 both emit to 0x50 (a wired-OR fan-in the physical-default chain cannot express). Requires the address-targeting reflash (top routes load_target into cpu_addr_w for opcodes 2/3; cell addr_match-gates SET_INPUT/SET_OUTPUT). Offsets are block-local from root.",
  "author": "Alan",
  "tags": ["test", "wiring", "icm-stream", "set-addr", "fan-in"],
  "relocatable": true,
  "offset_base": "block-local-16",
  "origin": 0,
  "inputs":  {"a": 64, "b": 65, "c": 66},
  "outputs": {"sum": 80, "tail": 81},
  "models": [],
  "records": [
    {"gs": 188, "in": 64, "out": 80, "init": null, "_note": "0x0BC XOR  in=0x40 out=0x50"},
    {"gs": 7,   "in": 65, "out": 80, "init": null, "_note": "0x007 AND  in=0x41 out=0x50 (fan-in to 0x50)"},
    {"gs": 36,  "in": 66, "out": 81, "init": null, "_note": "0x024 OR   in=0x42 out=0x51"}
  ]
}
