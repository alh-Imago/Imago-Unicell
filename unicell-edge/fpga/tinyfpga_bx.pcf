# tinyfpga_bx.pcf -- TinyFPGA BX pin constraints
# Target: iCE40LP8K-CM81

# Clock (16MHz internal oscillator)
set_io CLK B4

# UART
set_io PIN_1 A2   # TX
set_io PIN_2 A1   # RX

# User LED
set_io LED B3

# USB pull-up
set_io USBPU A3

# GPIO (available for expansion)
# set_io PIN_3  B1
# set_io PIN_4  C2
# set_io PIN_5  C1
# set_io PIN_6  D2
# set_io PIN_7  D1
# set_io PIN_8  E2
# set_io PIN_9  E1
# set_io PIN_10 G2
# set_io PIN_11 H1
# set_io PIN_12 J1
# set_io PIN_13 H2
