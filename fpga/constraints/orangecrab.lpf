# orangecrab.lpf — OrangeCrab ECP5 25F Pin Constraints
# Imago UniCell — Claudette v1.1
# Lattice ECP5 LFE5U-25F-8MG285C

LOCATE COMP "CLK"   SITE "A9";
IOBUF PORT "CLK"    IO_TYPE=LVCMOS33;
FREQUENCY PORT "CLK" 48.0 MHz;

LOCATE COMP "BTN"   SITE "V17";
IOBUF PORT "BTN"    IO_TYPE=SSTL135_I;

LOCATE COMP "RX"    SITE "M18";
IOBUF PORT "RX"     IO_TYPE=LVCMOS33;

LOCATE COMP "TX"    SITE "N17";
IOBUF PORT "TX"     IO_TYPE=LVCMOS33;

LOCATE COMP "LED_R" SITE "K4";
IOBUF PORT "LED_R"  IO_TYPE=LVCMOS33;

LOCATE COMP "LED_G" SITE "M3";
IOBUF PORT "LED_G"  IO_TYPE=LVCMOS33;

LOCATE COMP "LED_B" SITE "J3";
IOBUF PORT "LED_B"  IO_TYPE=LVCMOS33;
