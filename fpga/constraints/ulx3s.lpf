# ulx3s.lpf — ULX3S ECP5 85F Pin Constraints
# Imago UniCell — Claudette v1.1
# Lattice ECP5 LFE5U-85F-6BG381C

LOCATE COMP "CLK"      SITE "G2";
IOBUF PORT "CLK"       IO_TYPE=LVCMOS33;
FREQUENCY PORT "CLK"   25.0 MHz;

LOCATE COMP "BTN_PWR"  SITE "R1";
IOBUF PORT "BTN_PWR"   IO_TYPE=LVCMOS33;

LOCATE COMP "BTN[0]"   SITE "R1";
LOCATE COMP "BTN[1]"   SITE "T1";
LOCATE COMP "BTN[2]"   SITE "U1";
LOCATE COMP "BTN[3]"   SITE "V1";
LOCATE COMP "BTN[4]"   SITE "U1";
LOCATE COMP "BTN[5]"   SITE "H1";
LOCATE COMP "BTN[6]"   SITE "G1";
IOBUF PORT "BTN[*]"    IO_TYPE=LVCMOS33;

LOCATE COMP "RX"       SITE "M1";
IOBUF PORT "RX"        IO_TYPE=LVCMOS33;

LOCATE COMP "TX"       SITE "L4";
IOBUF PORT "TX"        IO_TYPE=LVCMOS33;

LOCATE COMP "LED[0]"   SITE "B2";
LOCATE COMP "LED[1]"   SITE "C2";
LOCATE COMP "LED[2]"   SITE "D2";
LOCATE COMP "LED[3]"   SITE "D1";
LOCATE COMP "LED[4]"   SITE "E2";
LOCATE COMP "LED[5]"   SITE "E1";
LOCATE COMP "LED[6]"   SITE "H3";
LOCATE COMP "LED[7]"   SITE "H2";
IOBUF PORT "LED[*]"    IO_TYPE=LVCMOS33;
