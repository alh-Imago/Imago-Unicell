# icebreaker.pcf — iCEBreaker v1.0 Pin Constraints
# Target: iCE40UP5K sg48 package
# Imago UniCell — Claudette v1.2

# Clock — 12MHz oscillator
set_io CLK     13    # OSCI — dedicated oscillator input, 12MHz (iCEBreaker v1.0e schematic)

# FTDI UART (via onboard FT2232H)
set_io -pullup yes RX       9    # FTDI TX -> FPGA RX
set_io TX       6    # FPGA TX -> FTDI RX

# User button (active low, has hardware debounce)
set_io -pullup yes BTN_N   10

# User LEDs (active low)
set_io LEDR_N  11
set_io LEDG_N  37
