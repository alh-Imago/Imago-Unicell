set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY top_stripped_grid5x5_v1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #103 step 1: scale-up baseline. ONLY the plain stripped
# cell (#88-#97) -- no wrapper (#99), no cardinal command channel (#100).
# 25 cells (5x5 grid), matching the real 25-cells-per-zone count used
# everywhere else in this project, so this is a genuine like-for-like
# scale-up from #97's 3-cell number, not an arbitrary size. ──
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/top_stripped_grid5x5_v1.v

set_global_assignment -name SDC_FILE stripped_grid5x5.sdc
