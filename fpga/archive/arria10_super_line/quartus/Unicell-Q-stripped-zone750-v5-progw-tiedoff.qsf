set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #209: DIAGNOSTIC-ONLY build, NOT functionally correct.
# top_stripped_zone750_v5_progw_tiedoff.v ties prog_data_in_w/
# prog_arrived_in_w to constant 0 for every interior cell, exactly
# matching top_stripped_grid5x5_wrapper_v1.v (#171's isolated 25-cell
# baseline, 3.36 ALM/cell). Real west-side command distribution is
# deliberately broken in this build. Purpose: confirm or rule out
# whether #209's uniform ~103-ALUT/cell interior cost (measured across
# ROW[13]/14/15 of the real v5 build) collapses back toward #171's
# baseline once this one input path goes dead again, same as it is in
# the isolated test. Pull the same Resource Utilization by Entity
# report against this build and compare directly to v5's own numbers
# -- NOT a build to flash for real operation. ──
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/cell_wrapper_v2.v
