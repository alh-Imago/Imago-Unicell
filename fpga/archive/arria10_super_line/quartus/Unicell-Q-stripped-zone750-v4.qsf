# target (16 zones x 750 = 12,000 cells). Combines wrapper (#127/#146) and
# command-cell (#126/#146) mechanisms on the complete #140-144 cell.
# Scaled up from the 50-cell base figure (#148/#149). ──
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
