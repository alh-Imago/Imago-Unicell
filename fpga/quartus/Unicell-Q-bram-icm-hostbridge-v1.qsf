set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY top_bram_icm_hostbridge_v1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #430's own queue item 2, first real slice: the FIRST real
# host-driven (not self-test-FSM-driven) hardware in this project's own
# history. Proves the real JTAG-to-BRAM and JTAG-to-ICM channels work on
# real silicon, in isolation from the full 3-chain v2 sentinel+gather
# mechanism (that integration is separate, later, not-yet-scoped work),
# per this project's own "smallest reproducible case first" discipline.
#
# CRITICAL: generate the real `issp_bram_icm` IP before building --
# IP Catalog -> In-System Sources and Probes, Source width = 91, Probe
# width = 112, ENABLE "Source Clock" (wire to the real fabric clock),
# ENABLE the source synchronization registers. NOT committed to git,
# per this project's own standing `docs/HARDWARE_SETUP.md`/
# `TOOLCHAIN_SETUP.md` convention -- regenerate locally first.
#
# Sim-verified clean first (tests/fpga/tb_top_bram_icm_hostbridge_v1.v,
# iverilog): real BRAM write-then-read at two addresses, write_done
# confirmed, two real ICM loads (SEL_ACC then SEL_LATCH) both confirmed
# via status_core_select readback, cmd_count confirmed accurate --
# deterministic across repeat runs, zero regression on the existing
# `sentinel_issp_bridge_v1.v` testbench.
# ──
set_global_assignment -name VERILOG_FILE ../verilog/adder_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/ram_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/adder_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/accumulator_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/compare_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/latch_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/nibble_mask_addon_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/shift_lane_addon_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/invert_addon_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/unicell_super_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/bram_controller_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/host_bridge_bram_icm_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/top_bram_icm_hostbridge_v1.v
