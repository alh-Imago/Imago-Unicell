# clock_walk_a.qsf — BUILD A of 2 (points.md #30, PLAN Step 2)
# 12 new per-channel refclk candidates from banks 1C+1D. See
# clock_walk_top_a.v's header for why this is split from the failed 32-pin
# single build (device has only 16 total IOPLL locations).
#
# Create a NEW Quartus project for this (do not add to any Unicell-Q*.qpf).
# Generate ONE fpll_ch0 IOPLL IP variation (100 MHz reference, `locked`
# exposed) + issp_clockwalk (probe width 44), add clock_walk_top_a.v, set
# TOP_LEVEL_ENTITY, compile, flash, run fpga/clock_walk_a.tcl.

set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY clock_walk_top_a
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── Bank 1C (6 new per-channel candidates) ──────────────────────────────────
set_location_assignment PIN_AL30 -to refclk_1c_rx0
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1c_rx0
set_location_assignment PIN_AJ30 -to refclk_1c_rx1
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1c_rx1
set_location_assignment PIN_AG30 -to refclk_1c_rx2
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1c_rx2
set_location_assignment PIN_AF32 -to refclk_1c_rx3
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1c_rx3
set_location_assignment PIN_AE30 -to refclk_1c_rx4
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1c_rx4
set_location_assignment PIN_AD32 -to refclk_1c_rx5
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1c_rx5

# ── Bank 1D (6 new per-channel candidates) ──────────────────────────────────
set_location_assignment PIN_AC30 -to refclk_1d_rx0
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1d_rx0
set_location_assignment PIN_AB32 -to refclk_1d_rx1
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1d_rx1
set_location_assignment PIN_AA30 -to refclk_1d_rx2
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1d_rx2
set_location_assignment PIN_Y32 -to refclk_1d_rx3
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1d_rx3
set_location_assignment PIN_W30 -to refclk_1d_rx4
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1d_rx4
set_location_assignment PIN_V32 -to refclk_1d_rx5
set_instance_assignment -name IO_STANDARD "HCSL" -to refclk_1d_rx5

set_global_assignment -name VERILOG_FILE clock_walk_top_a.v
set_global_assignment -name SDC_FILE "clock_walk_a.sdc"

# LED0_N/LED1_N left UNCONSTRAINED deliberately (Quartus auto-places them).
