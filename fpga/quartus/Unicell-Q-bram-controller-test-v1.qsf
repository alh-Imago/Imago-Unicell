set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY top_bram_controller_test_v1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #259/#260 continuation: first real Quartus M20K inference
# + size/timing check for bram_controller_v1.v at its real 40-bit
# native width. A single instance, self-testing (write+read+check a
# rolling 64-address window, sticky error LED). Watch "Total block
# memory bits" in the fit report -- should be nonzero, roughly tracking
# 2,621,440 bits (64K x 40), confirming real M20K inference rather than
# LUT-RAM fallback. ──
set_global_assignment -name VERILOG_FILE ../verilog/bram_controller_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/top_bram_controller_test_v1.v

set_global_assignment -name SDC_FILE bram_controller_test.sdc
