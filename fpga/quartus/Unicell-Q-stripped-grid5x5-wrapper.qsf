set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY top_stripped_grid5x5_wrapper_v1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #103 step 2: same 25-cell grid as step 1 (#104/#106), now
# with cell_wrapper_v1 (#99) attached to every cell, daisy-chained. The
# delta against step 1's baseline (146 ALMs, 257.14 MHz) is the wrapper's
# real, measured marginal cost. ──
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/cell_wrapper_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/top_stripped_grid5x5_wrapper_v1.v

set_global_assignment -name SDC_FILE stripped_grid5x5_wrapper.sdc
