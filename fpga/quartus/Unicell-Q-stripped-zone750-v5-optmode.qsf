set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY top_stripped_zone750_v5
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #206: #201's OPTIMIZATION_MODE experiment, run against
# v5's own RTL unchanged (top_stripped_zone750_v5, still -2.852ns/
# 89,818 ALM/259.61MHz per #198). NO RTL CHANGE from the v5 build --
# this qsf variant exists purely to test whether trading packing
# density for wire length/timing (per #201's correction to #199)
# closes any of the remaining slack. Deliberately kept as its own
# file (not overwriting v5.qsf) so v5's own baseline result stays
# directly comparable, per #201's own "run separately, not combined"
# note. ──
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/cell_wrapper_v2.v
set_global_assignment -name VERILOG_FILE ../verilog/cell_command_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/top_stripped_zone750_v5.v

set_global_assignment -name SDC_FILE stripped_zone750.sdc

# ── #201's experiment: trade packing density for wire length/timing
# directly, testing whether Quartus's default packing-driven placement
# (Alan's Chip Planner observation -- wires crossing half the die to
# reach packed resources) is what's keeping the self-loop/w0_bus-hop
# paths (#198) from closing. ──
set_global_assignment -name OPTIMIZATION_MODE "Aggressive Performance"
