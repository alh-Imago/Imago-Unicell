set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AX066H2F34E2SG
set_global_assignment -name TOP_LEVEL_ENTITY top_sentinel_gather_shared_bram_v2
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_location_assignment PIN_E23 -to CLK_100M

# ── points.md #436 (#430's queue item 1): real Quartus attempt for the
# collector_relay_v1-based redesign of the shared-BRAM sentinel+gather
# mechanism. Cloned from v1's own proven project (#426: 347 ALM,
# 188.86 MHz) rather than built from scratch, per this project's own
# "never modify a proven file/project in place" discipline -- v1's own
# project is untouched.
#
# THE REAL CHANGE under test: `collector_relay_v1.v` (#428, sim-proven
# standalone at points.md #428, #427's own principle -- the BRAM
# interface set-piece never needs to become a different core at
# runtime, so it shouldn't pay the super carrier shell's own
# reconfigurability tax) replaces the general-purpose `unicell_super_v1`
# shell + `cell_command_sequencer_v1:SEQ` pair in the COLLECTOR role.
# `cell_command_sequencer_v1.v` is dropped from THIS project's own file
# list (unused in v2 -- the round-robin index is now a trivial local
# counter, `active_dir_idx`, driven directly by the collector's own
# real fire+ack handshake completing). The module file itself is left
# untouched elsewhere in the repo -- other, separate, already-proven
# designs still use it unmodified.
#
# Real, predicted expectation (not yet measured): v1's own #426 numbers
# already showed nano alone cost 68.8 ALM (the single largest line item
# in that 347 ALM design) to deliver ONE narrow behavior, plus 9.5 ALM
# for the sequencer -- so a real ALM reduction somewhere in that
# neighborhood is expected here, not assumed. This build exists to
# MEASURE it, not confirm a guess.
#
# Sim-verified clean first (tests/fpga/tb_top_sentinel_gather_shared_
# bram_v2.v, iverilog): all 12 rounds correct, deterministic across
# repeat runs, zero regression against v1's own proven predecessor
# (re-run unchanged, still passes) and against `collector_relay_v1.v`'s
# own standalone testbench -- per this project's own standing
# "sim-first, then silicon" discipline.
# ──
set_global_assignment -name VERILOG_FILE ../verilog/adder_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/ram_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/adder_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/accumulator_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/compare_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/latch_cell_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/nibble_mask_addon_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/shift_lane_addon_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/invert_addon_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/unicell_stripped_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/unicell_super_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/collector_relay_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/addr_counter_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/sentinel_counter_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/bram_controller_v1.v
set_global_assignment -name VERILOG_FILE ../verilog/top_sentinel_gather_shared_bram_v2.v

set_global_assignment -name SDC_FILE top_sentinel_gather_shared_bram_v2.sdc
