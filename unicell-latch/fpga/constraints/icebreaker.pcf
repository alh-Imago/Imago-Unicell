# icebreaker.pcf — iCEBreaker Pin Constraints
# Imago UniCell — Claudette v2.1 / unicell-latch
# Target: iCE40UP5K sg48 package
#
# NOTE: No CLK pin — using internal SB_HFOSC oscillator (24MHz validated).
# External 12MHz crystal pin numbering inconsistent across docs — avoid.
#
# FTDI UART (via onboard FT2232H)
set_io -pullup yes RX       6    # IOB_13B — FTDI TX -> FPGA RX
set_io TX                   9    # IOB_16A — FPGA TX -> FTDI RX

# User button (active low)
set_io -pullup yes BTN_N   10

# User LEDs (active low)
set_io LEDR_N              11    # red LED
set_io LEDG_N              12    # green LED
